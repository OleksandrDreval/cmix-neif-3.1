# cmix-neif-2.0: adapted from cmix-neif-beehive (Vladimir Malinovskii, 2026,
# github.com/galqiwi/cmix-neif-beehive, commit 92c07c0b, training/beehive/tree/exp.env, sha256 056bddd6d6637dcc), GPL-3.
# Changes of cmix-neif-2.0 are marked '# 2.0'.
# training-form environment of the package (the environment of the last bf16 section of the cmix-neif-1.0
# chain), data path from $PKG
export TFT_GEOMETRY=poc8m_w2048
export PK_DUMP_DIR=${PKG:?set PKG to the package-D directory (training/README.md stage c)}
export TFT_DATA_DIR=$PKG
export TFT_MMAP=1
export ZCTX_ARM=pkd
export ZCTX_SEED=20260901
export PK_LAST_X0ROW=1
export PK_REDIRMERGE=1
export PK_SLOT_DIM=16
export TFT_OPTIMIZER_BATCH_TOKENS=1048576
export TFT_MICRO_BATCH_TOKENS=${TFT_MICRO_BATCH_TOKENS:-262144}
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
