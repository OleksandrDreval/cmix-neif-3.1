+QLinear TransformerImpl::load_qlinear(const WeightsFile& wf,
+                                      const std::string& prefix, int d_out,
+                                      int d_in) {
+  const WTensor& wq =
+      wf.get(prefix + ".weight.q", DT_I8,
+             {static_cast<uint32_t>(d_out), static_cast<uint32_t>(d_in)});
+  const WTensor& ws = wf.get(prefix + ".weight.scale", DT_BF16,
+                             {static_cast<uint32_t>(d_out)});
+  const WTensor& sa =
+      wf.get(prefix + ".quantize_activation.scale", DT_BF16, {1});
+
+  QLinear ql;
+  ql.d_out = d_out;
+  ql.d_in = d_in;
+  ql.stride = (d_in + 15) & ~15;
+  int8_t* w = static_cast<int8_t*>(wa.take(size_t(d_out) * ql.stride));
+  const int8_t* src = wq.i8();
+  for (int o = 0; o < d_out; o++) {
+    std::memcpy(w + size_t(o) * ql.stride, src + size_t(o) * d_in, d_in);
+    std::memset(w + size_t(o) * ql.stride + d_in, 0,
+                size_t(ql.stride - d_in));
+  }
+  for (size_t i = 0; i < wq.numel; i++)
+    if (src[i] < -7 || src[i] > 7) die("weight int out of [-7,7]");
+
+  float* fold = static_cast<float*>(fa.take(sizeof(float) * d_out));
+  ql.s_act = bf16_to_f32(sa.bf16_bits()[0]);
+  if (!(ql.s_act > 0.0f)) msg_stop(183);
+  for (int o = 0; o < d_out; o++)
+    fold[o] = ql.s_act * bf16_to_f32(ws.bf16_bits()[o]);
+  ql.w = w;
+  ql.fold = fold;
+  return ql;
+}
+
+void TransformerImpl::load(const char* path) {
+  WeightsFile wf = WeightsFile::load(path);
+
+  // config sanity
+  {
+    const WTensor& ci = wf.get("config.ints", DT_I32, {11});
+    const int32_t want[11] = {V, D, NL, DH, NH, DMLP, WIN, DH, NH, 4, 10000};
+    for (int i = 0; i < 11; i++)
+      if (ci.i32()[i] != want[i]) msg_stop(184);
+    const WTensor& ck = wf.get("config.kimi", DT_I32, {NL});
+    for (int i = 0; i < NL; i++)
+      if ((ck.i32()[i] != 0) != KIMI[i]) msg_stop(185);
+  }
+
+  wa.init(size_t(8) << 20);
+  fa.init(size_t(40) << 20);
+
+  // normed token embedding table
+  {
+    int emb_rows = V;
+    const bool want_last = wf.has("embedding.last_table.weight.q");
+    const bool want_match = wf.has("embedding.match_table.weight.q");
+    pk_present = want_last || want_match;
+    if (pk_present) emb_rows = 216;
+    pk_emb_rows = emb_rows;
+    const WTensor& eq = wf.get("embedding.weight.q", DT_I8,
+                               {static_cast<uint32_t>(emb_rows),
+                                static_cast<uint32_t>(D)});
+    const WTensor& es = wf.get("embedding.weight.scale", DT_BF16,
+                               {static_cast<uint32_t>(emb_rows)});
+    float* table =
+        static_cast<float*>(fa.take(sizeof(float) * size_t(emb_rows) * D));
+    for (int c = 0; c < emb_rows; c++) {
+      float s = bf16_to_f32(es.bf16_bits()[c]);
+      float* row = table + size_t(c) * D;
+      for (int i = 0; i < D; i++)
+        row[i] = static_cast<float>(eq.i8()[size_t(c) * D + i]) * s;
+      // the norm runs per step, after the projection terms
+      if (!pk_present)
+      rms_norm_vec(row, row, D);
+    }
+    tok_table = table;
+  }
+  if (pk_present) {
+    auto rows = [&](const std::string& prefix, int n_rows, int d) -> float* {
+      const WTensor& q = wf.get(prefix + ".weight.q", DT_I8,
+                                {static_cast<uint32_t>(n_rows),
+                                 static_cast<uint32_t>(d)});
+      const WTensor& sc = wf.get(prefix + ".weight.scale", DT_BF16,
+                                 {static_cast<uint32_t>(n_rows)});
+      float* p = static_cast<float*>(
+          fa.take(sizeof(float) * size_t(n_rows) * d));
+      for (int r = 0; r < n_rows; r++) {
+        const float s = bf16_to_f32(sc.bf16_bits()[r]);
+        for (int i = 0; i < d; i++)
