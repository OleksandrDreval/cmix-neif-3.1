+                        (unsigned int)(taproj > 0 ? taproj : aux_n_hid),
+                        (unsigned int)((taproj > 0) ? 1 : 0),
+                        0u, 0u,
+                        (unsigned int)((aux_zone != nullptr) ? 1 : 0)};
