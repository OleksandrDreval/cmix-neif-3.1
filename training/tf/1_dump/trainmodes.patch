+  std::exit(1);
+}
+
+size_t dtype_size(uint8_t dtype) {
+  switch (dtype) {
+    case DT_I8:
+      return 1;
+    case DT_BF16:
+      return 2;
+    case DT_F32:
+      return 4;
+    case DT_I32:
+      return 4;
+    default:
+      msg_stop(234);
+  }
+}
+
+struct Reader {
+  const uint8_t* p;
+  size_t left;
+  const char* path;
+
+  void need(size_t n) {
+    if (left < n) msg_stop(235);
+  }
+  void read(void* dst, size_t n) {
+    need(n);
+    std::memcpy(dst, p, n);
+    p += n;
+    left -= n;
+  }
+  uint32_t u32() {
+    uint32_t v;
+    read(&v, 4);
+    return v;
+  }
+  uint8_t u8() {
+    uint8_t v;
+    read(&v, 1);
+    return v;
+  }
+};
