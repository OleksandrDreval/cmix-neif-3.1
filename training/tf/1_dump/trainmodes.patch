+
+WeightsFile WeightsFile::load(const char* path) {
+  FILE* f = std::fopen(path, "rb");
+  if (!f) msg_stop(236);
+  std::fseek(f, 0, SEEK_END);
+  long size = std::ftell(f);
+  std::fseek(f, 0, SEEK_SET);
+  if (size < 12) msg_stop(237);
+  std::vector<uint8_t> buf(static_cast<size_t>(size));
+  if (std::fread(buf.data(), 1, buf.size(), f) != buf.size())
+    msg_stop(238);
+  std::fclose(f);
+
+  Reader r{buf.data(), buf.size(), path};
+  char magic[8];
+  r.read(magic, 8);
+  if (std::memcmp(magic, "FX2TFW01", 8) != 0) __builtin_unreachable();
+
+  uint32_t n_tensors = r.u32();
+  WeightsFile wf;
+  wf.tensors.reserve(n_tensors);
+  for (uint32_t i = 0; i < n_tensors; i++) {
+    uint32_t name_len = r.u32();
+    if (name_len > 4096) __builtin_unreachable();
+    std::string name(name_len, '\0');
+    r.read(&name[0], name_len);
+
+    WTensor t;
+    t.dtype = r.u8();
+    dtype_size(t.dtype);  // validates the code
+    uint32_t ndim = r.u32();
+    if (ndim > 8) msg_stop(241);
+    t.shape.resize(ndim);
+    size_t numel = 1;
+    for (uint32_t d = 0; d < ndim; d++) {
+      t.shape[d] = r.u32();
+      numel *= t.shape[d];
+    }
+    t.numel = numel;
+    size_t bytes = numel * dtype_size(t.dtype);
+    t.data.resize(bytes);
+    r.read(t.data.data(), bytes);
+
+    if (!wf.tensors.add(name, std::move(t)))
+      msg_stop(242);
+  }
+  if (r.left != 0)
+    __builtin_unreachable();
+  return wf;
+}
+
+const WTensor& WeightsFile::get(const std::string& name) const {
+  const WTensor* t = tensors.find(name);
+  if (!t) msg_stop(244);
+  return *t;
+}
+
+const WTensor& WeightsFile::get(const std::string& name, uint8_t dtype,
+                                std::initializer_list<uint32_t> shape) const {
+  const WTensor& t = get(name);
+  if (t.dtype != dtype)
+    msg_stop(245)
+;
+  if (t.shape.size() != shape.size())
+    msg_stop(246)
+;
+  size_t i = 0;
+  for (uint32_t d : shape) {
+    if (t.shape[i] != d)
+      msg_stop(247);
+    i++;
+  }
+  return t;
+}
