+void Head::TraceOpen() {
+  const char* p = std::getenv("CMIX_BITL_TRACE");
+  if (p == nullptr || *p == '\0') return;
+  trace_f = std::fopen(p, "wb");
+  if (trace_f == nullptr) return;
+  // CMIX_BITL_TRACE_WINDOWS="start:len,start:len,..." in STREAM BYTES.  Unset
+  // means one window over everything.  The head keeps running over the WHOLE
+  // stream (its weights and cell state must stay the ones the coder really
+  // had); only the RECORDING is restricted.
+  {
+    const char* w = std::getenv("CMIX_BITL_TRACE_WINDOWS");
+    if (w != nullptr && *w != '\0') {
+      int n = 1;
+      for (const char* q = w; *q; ++q) if (*q == ',') ++n;
+      twin_start = (unsigned long long*)std::calloc((size_t)n, 8);
+      twin_end = (unsigned long long*)std::calloc((size_t)n, 8);
+      const char* q = w;
+      while (*q && twin_n < n) {
+        char* e = nullptr;
+        const unsigned long long st = std::strtoull(q, &e, 10);
+        if (e == q || *e != ':') break;
+        q = e + 1;
+        const unsigned long long ln = std::strtoull(q, &e, 10);
+        if (e == q) break;
+        twin_start[twin_n] = st;
+        twin_end[twin_n] = st + ln;
+        ++twin_n;
+        q = (*e == ',') ? e + 1 : e;
+      }
+    }
+  }
+  // The column selection.  It stands BEFORE the header because it determines
+  // the record length.  Columns >= 64 are always kept (the mask is 64 bits).
+  tcols = EnvU64("CMIX_BITL_TRACE_COLS", 0ULL);
+  if (tcols != 0ULL) {
+    tcolidx = (int*)std::calloc((size_t)(n1 > 0 ? n1 : 1), sizeof(int));
+    tncol = 0;
+    for (int j = 0; j < n1; ++j) {
+      const bool keep = (j >= 64) || ((tcols >> j) & 1ULL);
+      if (keep) tcolidx[tncol++] = j;
+    }
+    if (tncol == 0) { tcols = 0ULL; std::free(tcolidx); tcolidx = nullptr; }
+  }
+  const int ncol = (tcols != 0ULL) ? tncol : (int)n1;
+  // Version 3 = like 2, but the column mask follows the window list.  Field 2
+  // stays the FULL width n1: the replay rebuilds the row at full width, so
+  // every column number keeps meaning what it means here.
+  unsigned int hdr[5] = {0x4c544942u, (tcols != 0ULL) ? 3u : 2u,
+                         (unsigned int)n1,
+                         (unsigned int)(8 + 4 * ncol),
+                         (unsigned int)twin_n};
