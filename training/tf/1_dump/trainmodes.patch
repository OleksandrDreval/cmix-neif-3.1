+
+// ONE per-BYTE channel for ALL extra blocks.  It carries, per byte, the TF
+// scalars, then the state vector, then the second state vector, then the gate
+// zone; the header names every width, so the replay reads the file without a
+// note on the side.  Separate files would be separate advances in lockstep - a
+// source of error without a counterpart.
+void Head::TraceAuxOpen() {
+  const char* p = std::getenv("CMIX_BITL_TRACE_AUX");
+  if (p == nullptr || *p == '\0') return;
+  thid_f = std::fopen(p, "wb");
+  if (thid_f == nullptr) return;
+  taproj = EnvInt("CMIX_BITL_TRACE_AUX_PROJ", 0);
+  if (taproj >= aux_n_hid || taproj < 0) taproj = 0;
+  if (taproj > 0) {
+    // The same stream and the same scale as the projection in the head, and
+    // drawn row by row - so a k'-wide record serves every k <= k' by PREFIX.
+    taP = Alloc(taproj * aux_n_hid);
+    taC = Alloc(taproj);
+    Rng prng(0x4849445052ULL);   // "HIDPR"
+    const float sc = 1.0f / std::sqrt((float)aux_n_hid);
+    for (int r = 0; r < taproj; ++r) {
+      for (int cc = 0; cc < aux_n_hid; ++cc) {
+        taP[r * aux_n_hid + cc] = (prng.Uniform(1.0f) >= 0.0f) ? sc : -sc;
+      }
+    }
+  }
