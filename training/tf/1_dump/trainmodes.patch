+    const WTensor& ck = wf.get("config.kimi", DT_I32, {NL});
+#else
     for (int i = 0; i < 11; i++)
       if (ci[i] != want[i]) msg_stop(184);
     const int32_t* ck = wf.T(TID("config.kimi")).i32();
+#endif
     for (int i = 0; i < NL; i++)
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+      if ((ck.i32()[i] != 0) != KIMI_L[i]) msg_stop(185);
+#else
       if ((ck[i] != 0) != KIMI_L[i]) msg_stop(185);
+#endif
   }
 
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+  paket.emb_rows = V;   // The start the member initialiser had
+  const bool want_last = wf.has("embedding.last_table.weight.q");
+  const bool want_match = wf.has("embedding.match_table.weight.q");
+#else
   constexpr bool want_last = TID_OPT("embedding.last_table.weight.q") >= 0;
   constexpr bool want_match = TID_OPT("embedding.match_table.weight.q") >= 0;
+#endif
   paket.present = want_last || want_match;
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+#else
   paket.emb_rows = V;
+#endif
   const int emb_rows = paket.present ? 216 : V;
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+  // the extra tables are ~220 KB; give them their own room instead of eating
+  // into the tail slack of the weight stream
+#endif
   pool.alloc(size_t(paket.present ? 20 : 16) << 20);
   size_t off = 0;
   auto take = [&](size_t n) -> uint8_t* {
     off = round64(off);
     uint8_t* q = pool.p + off;
     off += n;
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+    if (off + QMAT_TAIL_SLACK > pool.bytes) msg_stop(188);
+#endif
     return q;
   };
 
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+  // dense arena site in stream order
+  auto qsite = [&](const std::string& prefix, int d_out, int d_in,
+                   bool biased) -> QSite {
+    const WTensor& wq =
+        wf.get(prefix + ".weight.q", DT_I8,
+               {static_cast<uint32_t>(d_out), static_cast<uint32_t>(d_in)});
+    const WTensor& ws = wf.get(prefix + ".weight.scale", DT_BF16,
+                               {static_cast<uint32_t>(d_out)});
+    const WTensor& sa =
+        wf.get(prefix + ".quantize_activation.scale", DT_BF16, {1});
+#else
   // dense arena site in stream order; iq/is/ia: weight.q, weight.scale,
   // quantize_activation.scale of one site
   auto qsite = [&](int iq, int is, int ia, int blk, int d_out, int d_in) -> QSite {
+#endif
     QSite s;
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+    s.s_act = bf16_to_f32(sa.bf16_bits()[0]);
+    if (!(s.s_act > 0.0f)) msg_stop(183);
+    float fold[DMLP > V ? DMLP : V];   // D_out <= max(DMLP, V)
+    for (int o = 0; o < d_out; o++)
+      fold[o] = s.s_act * bf16_to_f32(ws.bf16_bits()[o]);
+#else
     s.s_act = bf16_to_f32(wf.T(ia, blk).bf16_bits()[0]);
     const uint16_t* ws = wf.T(is, blk).bf16_bits();
     float fold[DMLP > V ? DMLP : V];
     for (int o = 0; o < d_out; o++) fold[o] = s.s_act * bf16_to_f32(ws[o]);
+#endif
     uint8_t* dst = take(qdense_bytes(d_out, d_in));
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+    s.m = qdense_build(dst, wq.i8(), fold, d_out, d_in, biased);
+#else
     s.m = qdense_build(dst, wf.T(iq, blk).i8(), fold, d_out, d_in, true);
+#endif
     return s;
   };
+#if TRAIN_MODE == 2 || TRAIN_MODE == 3
+
+  // int4 sparse-column arena site (d_out must be 192): [fold | cols]
+  auto qsp4 = [&](const std::string& prefix, int d_in,
