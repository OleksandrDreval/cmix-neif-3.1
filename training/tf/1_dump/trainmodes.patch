--- a/src/tf1/tf1_manifest.h
+++ b/src/tf1/tf1_manifest.h
@@ -0,0 +1,309 @@
+#ifndef TF1_MANIFEST_H_
+#define TF1_MANIFEST_H_
+
+#include "../transformer.h"
+#include "../census_title.h"
+
+#define TF_MFAIL(...) transformer::Fail(__VA_ARGS__)
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <string>
+#include <vector>
+
+#include "tf1_prior0.h"
+#include "tf1_engine.h"   // transformer::Fail
+
+namespace tf_manifest {
+
+// ---- the scanner ----------------------------------------------------------
+
+inline bool ReadFile(const char* path, std::string* out) {
+  FILE* f = fopen(path, "rb");
+  if (!f) return false;
+  char buf[4096];
+  size_t n;
+  out->clear();
+  while ((n = fread(buf, 1, sizeof buf, f)) > 0) out->append(buf, n);
+  fclose(f);
+  return true;
+}
+
+// position just behind the `:` of "<key>" :
+inline size_t FindKey(const std::string& s, const char* key) {
+  const std::string needle = std::string("\"") + key + "\"";
+  size_t p = 0;
+  while ((p = s.find(needle, p)) != std::string::npos) {
+    size_t q = p + needle.size();
+    while (q < s.size() && (s[q] == ' ' || s[q] == '\t' || s[q] == '\n' ||
+                            s[q] == '\r')) ++q;
+    if (q < s.size() && s[q] == ':') return q + 1;
+    p += needle.size();
+  }
+  return std::string::npos;
+}
+
+inline size_t SkipWs(const std::string& s, size_t p) {
+  while (p < s.size() && (s[p] == ' ' || s[p] == '\t' || s[p] == '\n' ||
+                          s[p] == '\r')) ++p;
+  return p;
+}
+
+inline bool GetInt(const std::string& s, const char* key, long long* out) {
+  size_t p = FindKey(s, key);
+  if (p == std::string::npos) return false;
+  p = SkipWs(s, p);
+  bool neg = false;
+  if (p < s.size() && (s[p] == '-' || s[p] == '+')) { neg = s[p] == '-'; ++p; }
+  if (p >= s.size() || s[p] < '0' || s[p] > '9') return false;
+  long long v = 0;
+  while (p < s.size() && s[p] >= '0' && s[p] <= '9') {
+    v = v * 10 + (s[p] - '0');
+    ++p;
+  }
+  *out = neg ? -v : v;
+  return true;
+}
+
+inline bool GetStr(const std::string& s, const char* key, std::string* out) {
+  size_t p = FindKey(s, key);
+  if (p == std::string::npos) return false;
+  p = SkipWs(s, p);
+  if (p >= s.size() || s[p] != '"') return false;
+  size_t e = s.find('"', p + 1);
+  if (e == std::string::npos) return false;
+  out->assign(s, p + 1, e - p - 1);
+  return true;
+}
+
+// list of strings, e.g. "arme": ["z1t","syn","a2"]
+inline bool GetStrList(const std::string& s, const char* key,
+                       std::vector<std::string>* out) {
+  size_t p = FindKey(s, key);
+  if (p == std::string::npos) return false;
+  p = SkipWs(s, p);
+  if (p >= s.size() || s[p] != '[') return false;
+  ++p;
+  out->clear();
+  while (true) {
+    p = SkipWs(s, p);
+    if (p >= s.size()) return false;
+    if (s[p] == ']') return true;
+    if (s[p] == ',') { ++p; continue; }
+    if (s[p] != '"') return false;
+    size_t e = s.find('"', p + 1);
+    if (e == std::string::npos) return false;
+    out->push_back(s.substr(p + 1, e - p - 1));
+    p = e + 1;
+  }
+}
+
+// ---- what this build IS ---------------------------------------------------
+
+// the frozen byte set as the manifest writes it: 32 bytes, bit v&7 of byte
+// v>>3, printed as lower-case hex.
+inline std::string BitmapHex() {
+  unsigned char bm[32];
+  memset(bm, 0, sizeof bm);
+  for (int v = 0; v < 256; ++v) {
+    if (transformer::InSet(v)) bm[v >> 3] |= (unsigned char)(1u << (v & 7));
+  }
+  static const char* kHex = "0123456789abcdef";
+  std::string s;
+  for (int i = 0; i < 32; ++i) {
+    s.push_back(kHex[bm[i] >> 4]);
+    s.push_back(kHex[bm[i] & 15]);
+  }
+  return s;
+}
+
+// the arm list of THIS build, in a fixed order.  The names are the ones the
+// exporter writes (the manifest of the exported weight file).
+inline std::vector<std::string> Arme() {
+  std::vector<std::string> a;
+  a.push_back("paket");
+  a.push_back("match");
+  a.push_back("z3");
+  // the link context has one form, v2 (transformer.h)
+  a.push_back("z3_klein");   // link context with both spellings of the first letter
+  a.push_back("z3_quelle2");   // S178: source titles on top of the budget
+  a.push_back("z3_wahl2");
+  a.push_back("block2");  // S179: block mark, table v2
+  a.push_back("syn");
+  a.push_back("alias");
+  a.push_back("a2");
+  a.push_back("a2n");
+  a.push_back("x0row");
+  a.push_back("redirmerge");
+  a.push_back("okb_alias");
+  a.push_back("census");
+  a.push_back("censwert");
+  a.push_back(std::string("textanfang") + (char)('0' + (7)));
+  a.push_back("autart2");   // the author article, marks new / repetition
+  // stage 2: day number + kind + tab in front of every
+  // article line as author prompt rows; a head trained without them is RED
+  a.push_back("autokb3");
+  a.push_back("textform7");
+  return a;
+}
+
+inline std::string Join(const std::vector<std::string>& v) {
+  std::string s;
+  for (size_t i = 0; i < v.size(); ++i) {
+    if (i) s += ",";
+    s += v[i];
+  }
+  return s.empty() ? std::string("-") : s;
+}
+
+// ---- the watch ------------------------------------------------------------
+
+// the manifest sits next to the container: <path>.json, or with the container
+// suffix (.c2 / .bin) replaced by .bin.json -- that is how the exporter names
+// the pair today (weights-poc4m.c2 + weights-poc4m.bin.json).
+inline bool Locate(const char* weights_path, std::string* text,
+                   std::string* used) {
+  const std::string p(weights_path ? weights_path : "");
+  std::vector<std::string> cand;
+  cand.push_back(p + ".json");
+  size_t dot = p.find_last_of('.');
+  const std::string base = (dot == std::string::npos) ? p : p.substr(0, dot);
+  cand.push_back(base + ".bin.json");
+  cand.push_back(base + ".json");
+  for (size_t i = 0; i < cand.size(); ++i) {
+    if (ReadFile(cand[i].c_str(), text)) {
+      *used = cand[i];
+      return true;
+    }
+  }
+  return false;
+}
+
+inline void Check(const char* weights_path) {
+  std::string txt, used;
+  if (!Locate(weights_path, &txt, &used)) {
+    fprintf(stderr,
+        "no manifest next to %s (<path>.json or "
+        "<base>.bin.json); transformer and training form are not checked "
+        "in this run.  Arms of this build: %s\n",
+        weights_path ? weights_path : "(null)", Join(Arme()).c_str());
+    return;
+  }
+
+  std::vector<std::string> fehlt;
+  int geprueft = 0;
+  long long iv = 0;
+  std::string sv;
+
+  // --- geometry -----------------------------------------------------------
+  if (GetInt(txt, "vocabulary_size", &iv)) {
+    ++geprueft;
+    if (iv != 208) {
+      TF_MFAIL("%s reports vocabulary_size %lld, this "
+          "build uses V=%d.  A transformer with another vocabulary codes "
+          "other bytes.", used.c_str(), iv, 208);
+    }
+  } else {
+    fehlt.push_back("vocabulary_size");
+  }
+  if (GetInt(txt, "n_layers", &iv)) {
+    ++geprueft;
+    if (iv != 16) {
+      TF_MFAIL("%s reports n_layers %lld, this build "
+          "expects NEIF_TF1_NL=%d.", used.c_str(), iv, 16);
+    }
+  } else {
+    fehlt.push_back("n_layers");
+  }
+  if (GetStr(txt, "vocab_bitmap_hex", &sv)) {
+    ++geprueft;
+    if (sv != BitmapHex()) {
+      TF_MFAIL("%s carries another byte set than "
+          "this build.\n  manifest: %s\n  build   : %s", used.c_str(),
+          sv.c_str(), BitmapHex().c_str());
+    }
+  } else {
+    fehlt.push_back("vocab_bitmap_hex");
+  }
+
+  // --- package slot constants -------------------------------------------
+  {
+    struct { const char* a; const char* b; int soll; } kk[3] = {
+      {"x", "paket_x", 2},
+      {"nsent", "n_sentinel", 8},
+      {"dslot", "d_slot", 16},
+    };
+    for (int i = 0; i < 3; ++i) {
+      if (GetInt(txt, kk[i].a, &iv) || GetInt(txt, kk[i].b, &iv)) {
+        ++geprueft;
+        if (iv != kk[i].soll) {
+          TF_MFAIL("%s reports %s = %lld, this build "
+              "uses %d.", used.c_str(), kk[i].a, iv, kk[i].soll);
+        }
+      } else {
+        fehlt.push_back(kk[i].a);
+      }
+    }
+  }
+
+  // --- prior0 -------------------------------------------------------------
+  if (GetStr(txt, "prior0_sha", &sv) || GetStr(txt, "prior0_sha256", &sv)) {
+    ++geprueft;
+    if (sv != std::string(PRIOR0_SHA256)) {
+      TF_MFAIL("%s was trained with the prior0 table %s, "
+          "the stamped one is %s.  The substitute vector of every inserted "
+          "row would differ from the one of the training.",
+          used.c_str(), sv.c_str(), PRIOR0_SHA256);
+    }
+  } else {
+    fehlt.push_back("prior0_sha");
+  }
+
+  // --- the arm list -------------------------------------------------------
+  std::vector<std::string> m_arme;
+  if (GetStrList(txt, "arme", &m_arme) || GetStrList(txt, "arms", &m_arme)) {
+    ++geprueft;
+    std::vector<std::string> nur_bau, nur_manifest;
+    const std::vector<std::string> bau = Arme();
+    for (size_t i = 0; i < bau.size(); ++i) {
+      bool da = false;
+      for (size_t j = 0; j < m_arme.size(); ++j)
+        if (bau[i] == m_arme[j]) da = true;
+      if (!da) nur_bau.push_back(bau[i]);
+    }
+    for (size_t j = 0; j < m_arme.size(); ++j) {
+      bool da = false;
+      for (size_t i = 0; i < bau.size(); ++i)
+        if (bau[i] == m_arme[j]) da = true;
+      if (!da) nur_manifest.push_back(m_arme[j]);
+    }
+    if (!nur_bau.empty() || !nur_manifest.empty()) {
+      TF_MFAIL("transformer and build carry different "
+          "prompt arms.\n  only in the build (never seen by the transformer): %s\n"
+          "  only in the transformer (not built here): %s\n"
+          "  build %s | transformer %s", Join(nur_bau).c_str(),
+          Join(nur_manifest).c_str(), Join(bau).c_str(),
+          Join(m_arme).c_str());
+    }
+  } else {
+    fehlt.push_back("arme");
+  }
+
+  if (fehlt.empty()) {
+    fprintf(stderr, "%s geprueft, %d Felder stimmen "
+        "(Arme %s)\n", used.c_str(), geprueft, Join(Arme()).c_str());
+  } else {
+    fprintf(stderr,
+        "manifest without an arm list; %s carries %d of %d "
+        "checked fields, missing: %s.  The transformer is NOT checked against "
+        "the training form; arms of this build: %s\n",
+        used.c_str(), geprueft, geprueft + (int)fehlt.size(),
+        Join(fehlt).c_str(), Join(Arme()).c_str());
+  }
+}
+
+}  // namespace tf_manifest
+
+#endif
